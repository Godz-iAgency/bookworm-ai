rules_version = '2';

// Bookworm.AI Firestore security rules.
//
// Principle: a signed-in reader owns their profile and their courses, and
// nothing else. Billing state is written exclusively by our API routes via
// the Firebase Admin SDK (lib/firebase/admin.ts), which bypasses these rules
// entirely — so anything a client could forge for money or access is denied
// here rather than merely hidden in the UI.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function accountEnabled(uid) {
      let p = get(/databases/$(database)/documents/users/$(uid)).data;
      return (!('accessOverride' in p) || p.accessOverride == null || p.accessOverride.active == true)
        && (!('deletionPending' in p) || p.deletionPending == false);
    }

    // A Book Club member reads someone else's book directly and live — there is
    // no copy to grant access to instead. Both accounts must still be in good
    // standing, both must currently be in the SAME family (not just once, at
    // share time), and an active share record for this exact book must exist.
    // Any one of those going false (removed from the club, share withdrawn,
    // account disabled) closes the door on the very next read.
    function isSharedWithReader(ownerUid, courseId) {
      let reader = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let owner = get(/databases/$(database)/documents/users/$(ownerUid)).data;
      return isSignedIn()
        && (!('accessOverride' in reader) || reader.accessOverride == null || reader.accessOverride.active == true)
        && (!('deletionPending' in reader) || reader.deletionPending == false)
        && (!('accessOverride' in owner) || owner.accessOverride == null || owner.accessOverride.active == true)
        && (!('deletionPending' in owner) || owner.deletionPending == false)
        && reader.familyId != null
        && reader.familyId == owner.familyId
        && exists(/databases/$(database)/documents/families/$(owner.familyId)/sharedBooks/$(ownerUid + '_' + courseId));
    }

    // Fields that decide what a reader has paid for. Only the Admin SDK may
    // ever set these; a client that tries is rejected outright.
    function serverOnlyFields() {
      return [
        'plan',
        'trialStatus',
        'trialStartedAt',
        'trialEndsAt',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'stripePaymentMethodId',
        'monthResetAt',
        'showTrialEndWarning',
        'reminderEmailSentAt',
        'familyId',
        'isFamilyOwner',
        // The 7-day conversion window after a Book Club owner removes someone.
        // Client-writable, these would let the reader being removed simply
        // clear their own deletion deadline.
        'bookClubRemovedAt',
        'bookClubDeleteAt',
        // Complimentary access — the demo links and the Hudson account. A
        // client-writable "I don't pay" flag is not a flag, it is a free tier.
        'accessOverride', 'previewAttempts', 'deletionPending', 'subscriptionCancelAt',
        'paymentFailedAt', 'paymentFailureCount', 'billingEventCreated', 'lastPaidInvoice', 'lastPaidPeriod', 'previousSubscriptionId'
      ];
    }

    function touchesServerOnlyFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(serverOnlyFields());
    }

    // Generation usage is now reserved server-side. Clients cannot change
    // or delete the counter, including through a merge or field deletion.
    function generationCountNotRewound() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['generationsThisMonth']);
    }

    // A brand-new profile must start unpaid. Stops someone creating their own
    // document pre-set to a paid plan or an active trial.
    function createsAsUnpaid() {
      return request.resource.data.plan == 'free'
        && request.resource.data.trialStatus == null
        && request.resource.data.familyId == null
        && request.resource.data.isFamilyOwner == false
        && request.resource.data.stripeCustomerId == null
        && request.resource.data.stripeSubscriptionId == null
        && request.resource.data.generationsThisMonth == 0
        && request.resource.data.trialStartedAt == null
        && request.resource.data.trialEndsAt == null
        && request.resource.data.monthResetAt == null
        && request.resource.data.stripePaymentMethodId == null
        && !request.resource.data.keys().hasAny(['accessOverride', 'previewAttempts', 'deletionPending', 'bookClubDeleteAt', 'bookClubRemovedAt', 'lastPaidInvoice', 'lastPaidPeriod', 'billingEventCreated', 'previousSubscriptionId', 'subscriptionCancelAt', 'paymentFailedAt', 'paymentFailureCount']);
    }

    match /users/{uid} {
      allow get, list: if isOwner(uid);
      allow create: if isOwner(uid) && createsAsUnpaid();
      allow update: if isOwner(uid)
        && !touchesServerOnlyFields()
        && generationCountNotRewound();
      // Account deletion goes through support/Admin, never straight from the client.
      allow delete: if false;

      // A reader's courses are theirs alone to write and delete. A fellow
      // Book Club member may also read one directly — live, never a copy —
      // exactly while it is actively shared with their family (see
      // isSharedWithReader). Read-only: nothing below grants them write.
      match /courses/{courseId} {
        allow read: if (isOwner(uid) && accountEnabled(uid)) || isSharedWithReader(uid, courseId);
        allow delete: if isOwner(uid) && accountEnabled(uid);
        allow create: if false;
        allow update: if isOwner(uid) && accountEnabled(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharedFrom', 'expiresAt', 'id', 'book']);
      }

      // Each reader's own progress on a book someone else shared with the club
      // — which days they have opened/completed, their own commitments. Purely
      // theirs: ordinary per-user ownership, no sharing logic needed here at
      // all, because nobody but this reader ever has a reason to touch it.
      match /sharedProgress/{shareId} {
        allow read, write: if isOwner(uid) && accountEnabled(uid);
      }

      match /aiUsage/{day} {
        allow get: if isOwner(uid) && accountEnabled(uid);
        allow list, write: if false;
      }

      // Personal Development summaries — same ownership rule as courses.
      // Unlike courses, these carry no billing gate (see isBillingEnabled()
      // in lib/billing.ts), so there is nothing server-only about them here;
      // the client SDK writing them directly is the intended design, not a
      // shortcut around one.
      match /summaries/{summaryId} {
        allow read, write: if isOwner(uid) && accountEnabled(uid);
      }
    }

    // Book Club membership. Readable by members so the UI can show the roster;
    // all writes (creation, adding members, cancellation) are Admin SDK only.
    match /families/{familyId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;

      // Pointers to books members have shared — {sharedByUid, sourceCourseId,
      // sharedAt}, never the content itself. Closed to clients in both
      // directions: /api/family/* (lib/family-server.ts) is the only reader,
      // for the roster/expiry checks it does server-side. Its existence is
      // also what isSharedWithReader checks, above, to let a fellow member
      // read the sharer's actual course document — live, never a copy.
      match /sharedBooks/{shareId} {
        allow read, write: if false;
      }
    }

    // Invite codes are validated and redeemed server-side (/api/family/join).
    // Never readable by clients — otherwise codes could be enumerated.
    match /invites/{code} {
      allow read, write: if false;
    }

    // Password-free sign-in links (the Founders demo, the Hudson account).
    // A readable token here would be a sign-in credential handed to anyone who
    // asked, so these are server-only in both directions: redeemed by
    // /api/access/redeem, listed and switched off by /api/admin/links.
    match /accessLinks/{token} {
      allow read, write: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
